{
  "name": "@serikadev/serika.js",
  "version": "1.1.0",
  "description": "TypeScript SDK for SerikaCord: Discord v10-compatible bot REST API with bucket rate limits, gateway (zlib-stream, resume, sharding), interactions, components v2, and the SerikaCord client API.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "scripts": {
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true});require('fs').rmSync('.test-build',{recursive:true,force:true})\"",
    "build": "npm run clean && tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json --noEmit",
    "test": "tsc -p tsconfig.test.json && node --test .test-build/test/*.test.js",
    "prepublishOnly": "npm run build && npm test"
  },
  "keywords": [
    "serikacord",
    "serika",
    "discord",
    "discord-api",
    "bot",
    "gateway",
    "api",
    "wrapper",
    "typescript"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/serika-dev/serika.js.git"
  },
  "homepage": "https://github.com/serika-dev/serika.js#readme",
  "bugs": {
    "url": "https://github.com/serika-dev/serika.js/issues"
  },
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0"
  },
  "devDependencies": {
    "typescript": "^5.5.0",
    "@types/node": "^22.0.0",
    "@types/ws": "^8.5.0"
  },
  "peerDependencies": {
    "ws": "^8.18.0"
  },
  "peerDependenciesMeta": {
    "ws": {
      "optional": true
    }
  }
}
