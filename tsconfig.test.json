{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "rootDir": ".",
    "outDir": "./.test-build",
    "declaration": false,
    "declarationMap": false,
    "sourceMap": false,
    "inlineSources": false,
    "noEmitOnError": true
  },
  "include": ["src/**/*", "test/**/*"],
  "exclude": ["node_modules", "dist", ".test-build"]
}
